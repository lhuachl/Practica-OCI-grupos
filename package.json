{
  "name": "gymturno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js --dev",
    "test": "npm run build && cypress run",
    "test:unit": "cypress run --spec test/unit/domain.cy.js",
    "test:integration": "cypress run --spec test/integration/api.cy.js",
    "test:e2e": "npm run build && cypress run --spec test/e2e/gym.cy.js",
    "cypress:open": "npm run build && cypress open"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "cypress": "^16.3.0",
    "vite": "^8.0.0"
  }
}
